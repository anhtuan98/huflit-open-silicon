# Copy to .env and fill in real values. Never commit .env (see .gitignore).
#
# ADR-OS-005: AI tooling goes through an OpenAI-compatible API layer so the
# provider can be swapped by changing env vars only.

AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

